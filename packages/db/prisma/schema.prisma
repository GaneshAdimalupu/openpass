generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  role          Role           @default(ATTENDEE)
  createdAt     DateTime       @default(now())
  emailVerified Boolean        @default(false)
  image         String?
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  events        Event[]
  projects      Project[]
  proposals     Proposal[]
  registrations Registration[]
  sessions      Session[]
  volunteers    Volunteer[]
}

model Event {
  id                   String         @id @default(cuid())
  title                String
  slug                 String         @unique
  description          String?
  bannerUrl            String?
  startAt              DateTime
  endAt                DateTime
  venue                String?
  capacity             Int?
  isPublished          Boolean        @default(false)
  formSchema           Json?
  organiserId          String
  createdAt            DateTime       @default(now())
  category             String         @default("Other")
  deletedAt            DateTime?
  latitude             Float?
  longitude            Float?
  organization         String?
  registrationDeadline DateTime?
  requireApproval      Boolean        @default(false)
  tags                 String[]
  twitterHandle        String?
  websiteUrl           String?
  isFlagship           Boolean        @default(false)
  scheduleDates        String[]       @default([])
  scheduleHalls        String[]       @default([])
  showSchedule         Boolean        @default(false)
  organiser            User           @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  partners             Partner[]
  projects             Project[]
  proposals            Proposal[]
  registrations        Registration[]
  scheduleItems        ScheduleItem[]
  volunteers           Volunteer[]
}

model Registration {
  id          String             @id @default(cuid())
  eventId     String
  userId      String
  formData    Json?
  qrCode      String             @unique
  checkedIn   Boolean            @default(false)
  checkedInAt DateTime?
  createdAt   DateTime           @default(now())
  deletedAt   DateTime?
  status      RegistrationStatus @default(CONFIRMED)
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Proposal {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  title     String
  abstract  String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Partner {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  logoUrl   String?
  tier      String
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model ScheduleItem {
  id           String   @id @default(cuid())
  eventId      String
  title        String
  speaker      String?
  startTime    DateTime
  endTime      DateTime
  type         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  description  String?
  speakerImage String?
  venue        String?
  proposalId   String?
  videoLink    String?
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Volunteer {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  role      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String
  name      String
  imageUrl  String?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

model Project {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  title       String
  description String
  repoUrl     String?
  demoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logoUrl     String?
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  ORGANISER
  ATTENDEE
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}
