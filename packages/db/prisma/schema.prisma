generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  username         String?          @unique
  phone            String?
  image            String?
  passwordHash     String?
  emailVerified    DateTime?
  timeZone         String           @default("Asia/Kolkata")
  role             UserRole         @default(USER)
  identityProvider IdentityProvider @default(MAKEMYEVENT)
  whatsapp         String?
  instagram        String?
  twitter          String?
  linkedin         String?
  facebook         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accounts         Account[]
  organizers       Organizer[]
  memberships      OrganizerMember[]
  sessions         Session[]
  rsvpSubmissions  RsvpSubmission[]
  cfpSubmissions   CfpSubmission[]
  cfpReviews       CfpReview[]
  volunteeredEvents EventVolunteer[]
  issuedTickets    IssuedTicket[]
  communityMembers CommunityMember[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  deviceId     String?
  userAgent    String?
  browser      String?
  os           String?
  deviceType   String?   @default("DESKTOP")
  ipAddress    String?
  lastActive   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organizer {
  id          String            @id @default(cuid())
  type        OrganizerType
  category    String            @default("individual_host")
  name        String
  title       String?
  description String?
  logoUrl     String?
  instagram   String?
  twitter     String?
  website     String?
  slug        String            @unique
  ownerId     String
  createdAt   DateTime          @default(now())
  events      Event[]
  members     OrganizerMember[]
  communities Community[]
  owner       User              @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([type])
  @@index([category])
}

model OrganizerMember {
  id          String     @id @default(cuid())
  organizerId String
  userId      String?
  email       String
  name        String?
  role        MemberRole @default(VOLUNTEER)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  organizer   Organizer  @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizerId, email])
  @@index([organizerId])
  @@index([userId])
  @@index([email])
}

model Community {
  id          String            @id @default(cuid())
  organizerId String
  name        String
  slug        String            @unique
  description String?
  logoUrl     String?
  bannerUrl   String?
  category    String?           @default("tech")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  organizer   Organizer         @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  events      Event[]
  members     CommunityMember[]

  @@index([organizerId])
  @@index([slug])
}

model CommunityMember {
  id          String     @id @default(cuid())
  communityId String
  userId      String?
  email       String
  name        String?
  role        MemberRole @default(ADMIN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  community   Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([communityId, email])
  @@index([communityId])
  @@index([userId])
  @@index([email])
}

model Event {
  id                String      @id @default(cuid())
  title             String
  slug              String      @unique
  description       String?
  bannerUrl         String?
  format            String      @default("meetup")
  topic             String      @default("technology")
  tags              String[]
  status            EventStatus @default(draft)
  shortDescription  String?
  showSpeakers      Boolean     @default(true)
  eventStart        DateTime
  eventEnd          DateTime
  timezone          String      @default("Asia/Kolkata")
  registrationStart DateTime?
  registrationEnd   DateTime?
  isOnline          Boolean     @default(false)
  location          String?
  onlineLink        String?
  recordingLink     String?
  mapLink           String?
  isPaid            Boolean     @default(false)
  ticketDescription String?
  showRsvp          Boolean     @default(false)
  showSchedule      Boolean     @default(true)
  showPartners      Boolean     @default(true)
  capacity          Int?
  seriesId          String?
  organizerId       String
  communityId       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  organizer         Organizer   @relation(fields: [organizerId], references: [id])
  community         Community?  @relation(fields: [communityId], references: [id], onDelete: SetNull)
  tickets           Ticket[]
  issuedTickets     IssuedTicket[]
  rsvpSubmissions   RsvpSubmission[]
  rsvpForm          RsvpForm?
  cfpForm           CfpForm?
  cfpSubmissions    CfpSubmission[]
  scheduleItems     ScheduleItem[]
  partners          EventPartner[]
  volunteers        EventVolunteer[]

  @@index([organizerId])
  @@index([communityId])
  @@index([status])
  @@index([format])
  @@index([topic])
  @@index([eventStart])
}

model Ticket {
  id            String         @id @default(cuid())
  eventId       String
  name          String
  description   String?
  price         Int            @default(0)
  quantity      Int?           // null = unlimited
  maxPerOrder   Int            @default(1)
  salesStart    DateTime?
  salesEnd      DateTime?
  isPublished   Boolean        @default(true)
  allowWaitlist Boolean        @default(true)
  allowTransfer Boolean        @default(true)
  allowDrop     Boolean        @default(true)
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  issuedTickets IssuedTicket[]

  @@index([eventId])
}

model IssuedTicket {
  id            String         @id @default(cuid())
  ticketId      String
  eventId       String
  userId        String?
  ticketCode    String         @unique // "OPT-XXXX-YYYY"
  qrToken       String         @unique // Verification token
  attendeeName  String
  attendeeEmail String
  attendeePhone String?
  status        TicketStatus   @default(CONFIRMED)
  waitlistOrder Int?
  checkedInAt   DateTime?
  answers       String?        // JSON string
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  transfers     TicketTransfer[]

  @@index([eventId])
  @@index([ticketId])
  @@index([attendeeEmail])
  @@index([status])
  @@index([ticketCode])
  @@index([qrToken])
}

model TicketTransfer {
  id             String         @id @default(cuid())
  issuedTicketId String
  senderEmail    String
  recipientName  String
  recipientEmail String
  transferToken  String         @unique
  status         TransferStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  issuedTicket   IssuedTicket   @relation(fields: [issuedTicketId], references: [id], onDelete: Cascade)

  @@index([issuedTicketId])
  @@index([transferToken])
}

enum TicketStatus {
  CONFIRMED
  WAITLISTED
  DROPPED
  TRANSFERRED
  CHECKED_IN
  CANCELLED
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

model RsvpForm {
  id                     String    @id @default(cuid())
  eventId                String    @unique
  isPublished            Boolean   @default(false)
  allowEdit              Boolean   @default(false)
  requiresApproval       Boolean   @default(false)
  maxRsvpCount           Int       @default(100)
  description            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  event                  Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customQuestions        CustomQuestion[]

  @@index([eventId])
}

model CustomQuestion {
  id           String    @id @default(cuid())
  rsvpFormId   String
  question     String
  type         String    
  isMandatory  Boolean   @default(false)
  options      String?   
  description  String?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  rsvpForm     RsvpForm  @relation(fields: [rsvpFormId], references: [id], onDelete: Cascade)

  @@index([rsvpFormId])
}

enum UserRole {
  USER
  ADMIN
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  COORDINATOR
  VOLUNTEER
  VIEWER
  DEVICE
}

enum IdentityProvider {
  MAKEMYEVENT
  OPENEVENTS
  GOOGLE
  GITHUB
}

enum OrganizerType {
  personal
  education
  community
  professional
  venue
  public_sector
}

enum EventStatus {
  draft
  published
  completed
  cancelled
}

model RsvpSubmission {
  id                String    @id @default(cuid())
  eventId           String
  userId            String
  status            String    @default("Pending") // "Pending", "Accepted", "Rejected"
  confirmAttendance Boolean   @default(false)
  answers           Json?     // Stores mapping of Custom Question -> Answer
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns          RsvpCheckIn[]

  @@unique([eventId, userId])
}

model RsvpCheckIn {
  id               String         @id @default(cuid())
  submissionId     String
  timestamp        DateTime       @default(now())

  submission       RsvpSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model CfpForm {
  id                    String               @id @default(cuid())
  eventId               String               @unique
  isPublished           Boolean              @default(false)
  allowEdit             Boolean              @default(true)
  anonymiseProposals    Boolean              @default(false)
  hideReviews           Boolean              @default(false)
  onlyWorkshops         Boolean              @default(false)
  onlyTalks             Boolean              @default(false)
  deadline              DateTime?
  publicCustomResponses Boolean              @default(false)
  guidelines            String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  event                 Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customQuestions       CfpCustomQuestion[]
  submissions           CfpSubmission[]

  @@index([eventId])
}

model CfpCustomQuestion {
  id          String   @id @default(cuid())
  cfpFormId   String
  question    String
  type        String   
  isMandatory Boolean  @default(false)
  options     String?  
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cfpForm     CfpForm  @relation(fields: [cfpFormId], references: [id], onDelete: Cascade)

  @@index([cfpFormId])
}

model CfpSubmission {
  id             String      @id @default(cuid())
  eventId        String
  cfpFormId      String
  speakerId      String
  
  title          String
  sessionType    String      @default("talk")
  abstract       String
  targetAudience String      @default("all")
  duration       Int         @default(30)
  speakerBio     String?
  slidesUrl      String?

  answers        Json?
  status         String      @default("Pending")
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cfpForm        CfpForm     @relation(fields: [cfpFormId], references: [id], onDelete: Cascade)
  speaker        User        @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  reviews        CfpReview[]
  scheduleItems  ScheduleItem[]

  @@index([eventId])
  @@index([cfpFormId])
  @@index([speakerId])
  @@index([status])
}

model CfpReview {
  id           String        @id @default(cuid())
  submissionId String
  reviewerId   String
  score        Int?
  comment      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  submission   CfpSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer     User          @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([submissionId, reviewerId])
  @@index([submissionId])
  @@index([reviewerId])
}

model ScheduleItem {
  id                    String         @id @default(cuid())
  eventId               String
  title                 String
  description           String?
  scheduledDate         String         // e.g. "2026-09-15"
  startTime             String         // e.g. "10:00"
  endTime               String         // e.g. "10:45"
  stage                 String?        // e.g. "Main Auditorium", "Workshop Lab"
  type                  String         @default("talk") // "keynote", "talk", "workshop", "break", "networking"
  speakerName           String?

  linkedCfpSubmissionId String?
  linkedCfpSubmission   CfpSubmission? @relation(fields: [linkedCfpSubmissionId], references: [id], onDelete: SetNull)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  event                 Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([scheduledDate])
  @@index([linkedCfpSubmissionId])
}

model EventPartner {
  id          String   @id @default(cuid())
  eventId     String
  type        String   // "sponsor" | "community"
  name        String
  tier        String?  // "Platinum", "Gold", "Silver", "Bronze", "Venue Partner", "Custom"
  customTier  String?
  logoUrl     String?
  websiteUrl  String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([type])
}

model EventVolunteer {
  id          String   @id @default(cuid())
  eventId     String
  userId      String?
  name        String
  email       String
  role        String   @default("Volunteer") // "Core Team Member", "Volunteer", "Registration Desk", "Stage Manager", "Custom"
  customRole  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([eventId])
  @@index([userId])
  @@index([email])
}




