generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  phone            String?
  image            String?
  passwordHash     String?
  emailVerified    DateTime?
  timeZone         String           @default("Asia/Kolkata")
  role             UserRole         @default(USER)
  identityProvider IdentityProvider @default(OPENEVENTS)
  whatsapp         String?
  instagram        String?
  twitter          String?
  linkedin         String?
  facebook         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accounts         Account[]
  organizers       Organizer[]
  memberships      OrganizerMember[]
  sessions         Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organizer {
  id          String            @id @default(cuid())
  type        OrganizerType
  category    String            @default("individual_host")
  name        String
  title       String?
  description String?
  logoUrl     String?
  instagram   String?
  twitter     String?
  website     String?
  slug        String            @unique
  ownerId     String
  createdAt   DateTime          @default(now())
  events      Event[]
  members     OrganizerMember[]
  owner       User              @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([type])
  @@index([category])
}

model OrganizerMember {
  id          String     @id @default(cuid())
  organizerId String
  userId      String?
  email       String
  name        String?
  role        MemberRole @default(VOLUNTEER)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  organizer   Organizer  @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizerId, email])
  @@index([organizerId])
  @@index([userId])
  @@index([email])
}

model Event {
  id                String      @id @default(cuid())
  title             String
  slug              String      @unique
  description       String?
  bannerUrl         String?
  format            String      @default("meetup")
  topic             String      @default("technology")
  tags              String[]
  status            EventStatus @default(draft)
  eventStart        DateTime
  eventEnd          DateTime
  timezone          String      @default("Asia/Kolkata")
  registrationStart DateTime?
  registrationEnd   DateTime?
  isOnline          Boolean     @default(false)
  location          String?
  onlineLink        String?
  capacity          Int?
  seriesId          String?
  organizerId       String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  organizer         Organizer   @relation(fields: [organizerId], references: [id])
  tickets           Ticket[]

  @@index([organizerId])
  @@index([status])
  @@index([format])
  @@index([topic])
  @@index([eventStart])
}

model Ticket {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  price     Int      @default(0)
  quantity  Int?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

enum UserRole {
  USER
  ADMIN
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  COORDINATOR
  VOLUNTEER
  VIEWER
  DEVICE
}

enum IdentityProvider {
  OPENEVENTS
  GOOGLE
  GITHUB
}

enum OrganizerType {
  personal
  education
  community
  professional
  venue
  public_sector
}

enum EventStatus {
  draft
  published
  completed
  cancelled
}
